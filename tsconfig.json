{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "types": ["$app/types", "node"]
  },
  "include": ["src", "server", "shared", "desktop", "scripts", "e2e", "*.ts"]
}
