{
  "name": "@linker-edit/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The browser UI of Linker-Edit, built into the Rust server; and the scripts that package releases.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#shared/*": "./shared/*"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "prepare": "svelte-kit sync || echo \"\"",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.67.0",
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "cookie": "^2.0.1",
    "ffmpeg-static": "^5.3.0",
    "marked": "^18.1.3",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
