{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "crates/app/icons/icon.svg",
  "defaultThreadEnvMode": "worktree",
  "scripts": [
    {
      "name": "Setup worktree",
      "command": "npm ci && cargo fetch",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Dev",
      "command": "npm run dev",
      "icon": "play",
      "previewUrl": "http://localhost:5317"
    },
    {
      "name": "Check",
      "command": "npm run typecheck && cargo clippy --workspace --all-targets -- -D warnings",
      "icon": "lint"
    },
    {
      "name": "Test",
      "command": "npm test && cargo test --workspace",
      "icon": "test"
    }
  ]
}
