{
  "name": "linker-edit-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w apps/desktop",
    "build": "npm run build -w apps/desktop",
    "start": "cargo run -p linker-edit -- serve",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w apps/desktop",
    "test:live": "cargo run -p linker-edit-server --example live_check --",
    "record-fixture": "cargo run -p linker-edit-server --example record_fixture --"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
