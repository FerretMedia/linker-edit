{
  "name": "linker-edit-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w apps/desktop",
    "dev:desktop": "npm run dev:desktop -w apps/desktop",
    "build": "npm run build -w apps/desktop",
    "dist:desktop": "npm run dist:desktop -w apps/desktop",
    "start": "npm run start -w apps/desktop",
    "typecheck": "npm run typecheck -w apps/desktop",
    "test": "npm run test -w apps/desktop",
    "test:e2e": "npm run test:e2e -w apps/desktop",
    "test:live": "npm run test:live -w apps/desktop",
    "record-fixture": "npm run record-fixture -w apps/desktop"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller": false
  }
}
