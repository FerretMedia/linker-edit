{
  "name": "linker-edit",
  "version": "0.0.0",
  "type": "module",
  "description": "Open-source AI for video editing and creative work. Claude and Codex edit your DaVinci Resolve project directly.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FerretMedia/linker-edit.git"
  },
  "bin": {
    "linker-edit": "dist/linker-edit.js"
  },
  "files": [
    "build",
    "dist",
    "desktop/preload.cjs",
    "server/resolve/scripts/*.py",
    "NOTICE",
    "linker-edit.config.example.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#shared/*": "./shared/*"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"node --watch server/index.ts\" \"vite dev\"",
    "dev:desktop": "rolldown -c && concurrently -k -n server,web,app -c blue,magenta,green \"node --watch server/index.ts\" \"vite dev\" \"electron dist/desktop.js\"",
    "build": "vite build && rolldown -c",
    "dist:desktop": "npm run build && node scripts/build-desktop.ts",
    "start": "node server/index.ts",
    "prepare": "svelte-kit sync || echo \"\"",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "node scripts/live-check.ts",
    "record-fixture": "node scripts/record-fixture.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "@openai/codex-sdk": "^0.166.0",
    "electron": "^45.2.3",
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0",
    "marked": "^18.1.3",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.67.0",
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "cookie": "^2.0.1",
    "electron-builder": "^26.18.0",
    "rolldown": "^1.2.16",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller": false
  }
}
